OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-model-id

# Optional: set this when using an OpenAI-compatible provider.
OPENAI_BASE_URL=https://your-provider.example/v1

MODEL_TEMPERATURE=0

MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
MODEL_MAX_COMPLETION_TOKENS=400
AGENT_MAX_TURNS=4
AGENT_RUNTIME_TYPE=legacy
AGENT_CHECKPOINT_DB_PATH=agent_runs.sqlite3

# Whole-run deadline. 0 means auto: MODEL_TIMEOUT_SECONDS * (AGENT_MAX_TURNS + 1).
AGENT_RUN_TIMEOUT_SECONDS=0

# Trace policy. Content (questions, answers, tool arguments) is redacted by
# default; enable capture only in a trusted local environment.
TRACE_CAPTURE_CONTENT=false
TRACE_MAX_STRING_LENGTH=200
TRACE_RETENTION_DAYS=7

# Optional token pricing used by `python main.py --metrics` cost estimation.
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0

# HTTP service boundary (python -m service). Format: tenant_id:api_key pairs.
SERVICE_API_KEYS=team-a:replace-with-a-16-char-key
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
SERVICE_RATE_LIMIT_PER_MINUTE=60
SERVICE_MAX_BODY_BYTES=20000
SERVICE_REQUEST_TIMEOUT_SECONDS=120
SERVICE_AUDIT_PATH=observability/audit/service.jsonl
# Chat transcript database (defaults to AGENT_CHECKPOINT_DB_PATH).
SERVICE_SESSION_DB_PATH=agent_runs.sqlite3
# Static Web UI directory served at "/".
SERVICE_WEB_DIR=web
# Refuse to bind a non-loopback address unless this is explicitly true.
SERVICE_ALLOW_PUBLIC_EXPOSURE=false
